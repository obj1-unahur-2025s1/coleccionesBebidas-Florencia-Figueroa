import tito.*

describe "test de tito" {

    method initialize() {
        tito.consumir(5,wisky)
    }
    method consumoTerere() {
        tito.consumir(5,terere)
    }

    test "tito tiene peso 70" {
        assert.equals(70,tito.peso())
    }
    test "la velocidad de tito" {
        assert.equals(0.9**5*490/70,tito.velocidad())
    }
    test "ahora la velocidad es 7 porque consumio terere" {
        self.consumoTerere()
        assert.equals(7,tito.velocidad())
    }
    test "si consume cianuro la velocidad es cero porque muere" {
        tito.consumir(5, cianuro)
        assert.equals(0,tito.velocidad())
    }
    test"el rendimiento de un licuado con algunos nutrientes"{
        licuado.agregar(10) // --> 10 de nutriente
        licuado.agregar(5) // --> 10 de nutriente
        assert.equals(30 ,licuado.rendimiento(2))
    }
    test"tito consume un coctel normal y su velocidad es de 13.3"{
        tito.consumir(1, coctelDeBebidas)
        assert.equals(13.3, tito.velocidad())
    }
    test"tito consume un coctel suave con agua saborizada y su velocidad es de 20.853"{
        coctelSuave.agregar(aguaSaborizada)
        tito.consumir(3, coctelSuave)
        assert.equals(20.853, tito.velocidad())
    }
}
